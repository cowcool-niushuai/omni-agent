# Copy to .env and fill in. Never commit .env.
OMNI_ENVIRONMENT=dev
HOST=127.0.0.1
PORT=8001
WORKSPACE_DIR=./workspace
DATA_DIR=./data

# Comma-separated. Empty means only the local UI origins are allowed.
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

LOG_LEVEL=INFO
LOG_JSON=false
MAX_ITERATIONS=8

# Provider keys. Leave blank for providers you do not use.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
GOOGLE_API_KEY=
SILICONFLOW_API_KEY=

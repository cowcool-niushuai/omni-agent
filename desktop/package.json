{
  "name": "omni-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OmniAgent desktop client",
  "homepage": "https://github.com/omni-agent/omni-agent",
  "author": {
    "name": "OmniAgent Maintainers",
    "email": "maintainers@omniagent.dev"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "backend:build": "bash build_backend.sh",
    "pack": "npm run backend:build && electron-builder --dir",
    "dist": "npm run backend:build && electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ai.omniagent.desktop",
    "productName": "OmniAgent",
    "artifactName": "OmniAgent-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "backend.js",
      "preload.js",
      "splash-preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "resources/icon.png",
      "executableName": "omni-agent"
    }
  }
}

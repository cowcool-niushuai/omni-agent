# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=dev
HOST=127.0.0.1
PORT=8001
WORKSPACE_DIR=./workspace
DATA_DIR=./data

# Comma-separated. Empty means only the local UI origins are allowed.
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

LOG_LEVEL=INFO
LOG_JSON=false
MAX_ITERATIONS=8
CONTEXT_MAX_TOKENS=24000
CONTEXT_KEEP_LAST=12

# Phase 2: sandbox, command policy and tool quotas
# auto = use bubblewrap when installed, otherwise process-level isolation
SANDBOX_BACKEND=auto
SANDBOX_NETWORK=false
SANDBOX_EXTRA_RO_BINDS=
COMMAND_POLICY_MODE=strict
COMMAND_TIMEOUT_SECONDS=30
COMMAND_MAX_MEMORY_MB=512
COMMAND_MAX_CPU_SECONDS=30
COMMAND_MAX_FILE_MB=50
COMMAND_MAX_OUTPUT_BYTES=256000
PYTHON_EVAL_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=60
SUBAGENT_TIMEOUT_SECONDS=300
TOOL_MAX_OUTPUT_CHARS=12000
TOOL_MAX_CONCURRENCY=4
MAX_FILE_WRITE_BYTES=10485760
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_MAX_REDIRECTS=3
WEB_FETCH_ALLOWED_PORTS=80,443,8080,8443
ALLOW_PRIVATE_NETWORK=false
MCP_REQUEST_TIMEOUT_SECONDS=15
AUDIT_ENABLED=true

# Provider keys. Leave blank for providers you do not use.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
GOOGLE_API_KEY=
SILICONFLOW_API_KEY=
